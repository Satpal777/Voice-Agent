# Sarvam AI API Key
# Get your API key at: https://sarvam.ai/
SARVAM_API_KEY=YOUR_SARVAM_API_KEY

# STT mode: batch (default, REST API per speech segment) or realtime (WebSocket streaming)
SARVAM_STT_MODE=batch

# Output: transcribe (original language) or translate (to English)
SARVAM_STT_OUTPUT=transcribe

# Language: auto/unknown for detection, or hi-IN, gu-IN, en-IN, etc.
SARVAM_LANGUAGE_CODE=auto

# Pause duration (ms) before a speech segment is sent for transcription
SARVAM_SILENCE_MS=500

# Sarvam TTS (text-to-speech for assistant replies)
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_SAMPLE_RATE=24000

# Google Gemini API Key
# Get your API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
GEMINI_MAX_RETRIES=2

# Logging: debug | info | warn | error
LOG_LEVEL=info

PORT=3000
