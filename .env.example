# Sarvam AI API Key
# Get your API key at: https://sarvam.ai/
SARVAM_API_KEY=YOUR_SARVAM_API_KEY

# STT mode: auto (default, prefers batch), batch (REST per segment), or realtime (WebSocket)
SARVAM_STT_MODE=auto

# Output: transcribe (original language) or translate (to English)
SARVAM_STT_OUTPUT=transcribe

# Language: auto/unknown for detection, or hi-IN, gu-IN, en-IN, etc.
SARVAM_LANGUAGE_CODE=auto

# Pause duration (ms) before a speech segment is sent for transcription (batch mode)
SARVAM_SILENCE_MS=350

# Sarvam TTS (text-to-speech for assistant replies)
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_SAMPLE_RATE=24000

# LLM provider (default: ollama)
LLM_PROVIDER=ollama

# Ollama Cloud API key — create at https://ollama.com/settings/keys
# Required when OLLAMA_HOST points to ollama.com
OLLAMA_API_KEY=YOUR_OLLAMA_API_KEY

# Ollama host: https://ollama.com for cloud, http://localhost:11434 for local
OLLAMA_HOST=https://ollama.com

# Cloud model names omit the -cloud suffix when using ollama.com directly
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_FALLBACK_MODEL=gpt-oss:120b
OLLAMA_MAX_RETRIES=2

# Logging: debug | info | warn | error
LOG_LEVEL=info

PORT=3000
